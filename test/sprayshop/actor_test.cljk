(ns sprayshop.actor-test
  (:require [kotoba.test :refer [deftest is testing]]
            [sprayshop.actor :as actor]
            [sprayshop.store :as store]))

(defn- fresh-store []
  (let [st (store/mem-store)]
    (store/register-sprayer! st {:sprayer-id "sprayer-1" :name "Kobo Yamada"})
    (store/register-shop! st {:shop-id "SH-1" :name "Kobo Spray Shop" :max-supply-cost 2000})
    st))

(deftest commits-a-registered-work-log
  (let [st (fresh-store)
        graph (actor/build-graph {:store st})
        request {:sprayer-id "sprayer-1" :op :log-work-record :stake :low
                  :shop-id "SH-1" :task "cabinet-door spray-coating progress log"}
        result (actor/run-request! graph request {} "thread-1")]
    (is (= :done (:status result)))
    (is (some? (get-in result [:state :record])))
    (is (= 1 (count (store/records-of st "sprayer-1"))))))

(deftest holds-an-unregistered-shop-proposal
  (let [st (fresh-store)
        graph (actor/build-graph {:store st})
        request {:sprayer-id "sprayer-1" :op :log-work-record :stake :low
                  :shop-id "SH-ghost" :task "cabinet-door spray-coating progress log"}
        result (actor/run-request! graph request {} "thread-2")]
    (is (= :hold (:disposition (:state result))))
    (is (empty? (store/records-of st "sprayer-1")))))

(deftest interrupts-then-approves-safety-concern-on-human-approval
  (let [st (fresh-store)
        graph (actor/build-graph {:store st})
        request {:sprayer-id "sprayer-1" :op :flag-safety-concern :stake :low
                  :shop-id "SH-1" :hazard-type :fume-exposure-risk}
        interrupted (actor/run-request! graph request {} "thread-3")]
    (is (= :interrupted (:status interrupted)))
    (is (empty? (store/records-of st "sprayer-1")))
    (let [resumed (actor/approve! graph "thread-3")]
      (is (= :done (:status resumed)))
      (is (= 1 (count (store/records-of st "sprayer-1")))))))

(deftest holds-a-scope-excluded-op-even-at-high-confidence
  (testing "an actor run can never commit a proposal that would finalize a spray-application-execution decision, regardless of disposition path"
    (let [st (fresh-store)
          graph (actor/build-graph {:store st})
          request {:sprayer-id "sprayer-1" :op :finalize-spray-application-decision :stake :low
                    :shop-id "SH-1" :task "spray-application decision"}
          result (actor/run-request! graph request {} "thread-4")]
      (is (= :done (:status result)))
      (is (= :hold (:disposition (:state result))))
      (is (empty? (store/records-of st "sprayer-1"))))))
